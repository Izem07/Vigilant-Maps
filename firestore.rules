rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /traps/{trapId} {
      allow read: if true;
      // Validate shape on create; no client updates/deletes (cleanup runs server-side).
      allow create: if request.resource.data.keys().hasOnly(
                         ['latitude', 'longitude', 'geohash', 'g5', 'type', 'timestamp'])
                    && request.resource.data.latitude is number
                    && request.resource.data.longitude is number
                    && request.resource.data.g5 is string
                    && request.resource.data.g5.size() == 5
                    && request.resource.data.type in ['cop', 'camera', 'speed_trap']
                    && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }
  }
}
